{
  "expo": {
    "name": "Expense Manager",
    "slug": "ExpenseManager",
    "scheme": "expensemanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16A085"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sachida.expensemanager",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock Expense Manager."
      }
    },
    "android": {
      "package": "com.sachida.expensemanager",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16A085"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock Expense Manager."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": ["image/*"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
